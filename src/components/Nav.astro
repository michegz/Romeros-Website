---
const links = [
  { label: 'Services', href: '/services' },
  { label: 'Emergency', href: '/emergency-repairs' },
  { label: 'Property Managers', href: '/property-managers' },
  { label: 'About', href: '/about' },
  { label: 'Contact', href: '/contact' },
];

const currentPath = Astro.url.pathname;
---
<header class="sticky top-0 z-50 bg-white shadow-sm">
  <nav class="max-w-6xl mx-auto px-4 flex items-center justify-between h-16" aria-label="Main navigation">
    <!-- Logo -->
    <a href="/" class="flex items-center gap-2 shrink-0">
      <!-- PLACEHOLDER: Replace text with logo image when asset is available.
           <img src="/images/logo.webp" alt="Romero's Service Company" width="160" height="40" class="h-10 w-auto" loading="eager" />
      -->
      <span class="font-bold text-navy text-lg leading-tight">
        Romero's<br /><span class="text-xs font-normal text-gray-500 tracking-wide">Service Company</span>
      </span>
    </a>

    <!-- Desktop nav -->
    <div class="hidden md:flex items-center gap-5 text-sm font-medium">
      {links.map((link) => (
        <a
          href={link.href}
          class={`hover:text-accent transition-colors ${currentPath === link.href ? 'text-accent' : 'text-gray-700'}`}
        >
          {link.label}
        </a>
      ))}
      <a
        href="tel:3373660592"
        class="ml-2 bg-accent text-white font-bold px-4 py-2 rounded-lg hover:bg-orange-700 transition-colors whitespace-nowrap"
      >
        (337) 366-0592
      </a>
    </div>

    <!-- Mobile: phone only -->
    <a
      href="tel:3373660592"
      class="md:hidden bg-accent text-white font-bold px-4 py-2 rounded-lg text-sm hover:bg-orange-700 transition-colors"
      aria-label="Call Romero's Service Company"
    >
      (337) 366-0592
    </a>
  </nav>
</header>
