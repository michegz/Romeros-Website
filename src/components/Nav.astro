---
const links = [
  { label: 'Services', href: '/services' },
  { label: 'Emergency', href: '/emergency-repairs' },
  { label: 'Property Managers', href: '/property-managers' },
  { label: 'About', href: '/about' },
  { label: 'Contact', href: '/contact' },
];

const currentPath = Astro.url.pathname;
---
<header class="sticky top-0 z-50 bg-stone-50 border-b border-stone-200">
  <nav class="max-w-6xl mx-auto px-4 flex items-center justify-between h-16" aria-label="Main navigation">
    <!-- Logo -->
    <a href="/" class="flex items-center shrink-0">
      <img
        src="/images/logo.svg"
        alt="Romero's Service Company"
        width="140"
        height="48"
        class="h-12 w-auto"
        loading="eager"
        fetchpriority="high"
      />
    </a>

    <!-- Desktop nav -->
    <div class="hidden md:flex items-center gap-5 text-sm font-medium">
      {links.map((link) => (
        <a
          href={link.href}
          class={`transition-colors ${currentPath === link.href ? 'text-brand font-semibold' : 'text-stone-600 hover:text-brand'}`}
        >
          {link.label}
        </a>
      ))}
      <a
        href="tel:3373660592"
        class="ml-2 bg-brand text-white font-bold px-4 py-2 rounded-lg hover:bg-brand-mid transition-colors whitespace-nowrap"
      >
        (337) 366-0592
      </a>
    </div>

    <!-- Mobile: phone only -->
    <a
      href="tel:3373660592"
      class="md:hidden bg-brand text-white font-bold px-4 py-2 rounded-lg text-sm hover:bg-brand-mid transition-colors"
      aria-label="Call Romero's Service Company"
    >
      (337) 366-0592
    </a>
  </nav>
</header>
