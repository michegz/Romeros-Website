---
import Head from '../components/Head.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  canonical: string;
  ogImage?: string;
  ogType?: string;
  preloadHero?: string;
  schema?: string | string[];
}

const { title, description, canonical, ogImage, ogType, preloadHero, schema } = Astro.props;
---
<!doctype html>
<html lang="en">
  <Head
    {title}
    {description}
    {canonical}
    {ogImage}
    {ogType}
    {preloadHero}
    {schema}
  />
  <body class="font-sans text-gray-900 bg-white antialiased">
    <Nav />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
